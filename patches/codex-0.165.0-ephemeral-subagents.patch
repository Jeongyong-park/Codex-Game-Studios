+#[tokio::test]
+async fn ephemeral_parent_full_history_fork_keeps_live_context_without_rollout() {
+    let (home, mut config) = test_config().await;
+    config.ephemeral = true;
+    let harness = AgentControlHarness::new_with_config(home, config).await;
+    let (parent_thread_id, parent) = harness.start_thread().await;
+    parent
+        .inject_response_items(vec![user_message("ephemeral inheritance marker")])
+        .await
+        .expect("inject parent context");
+    assert!(parent.rollout_path().is_none());
+    let child_id = harness
+        .spawn_anonymous_child(
+            parent_thread_id,
+            SpawnAgentOptions {
+                parent_thread_id: Some(parent_thread_id),
+                fork_parent_spawn_call_id: Some("ephemeral-spawn-call".to_string()),
+                fork_mode: Some(SpawnAgentForkMode::FullHistory),
+                ..Default::default()
+            },
+        )
+        .await;
+    let child = harness
+        .manager
+        .get_thread(child_id)
+        .await
+        .expect("child exists");
+    assert!(history_contains_text(
+        child.session.clone_history().await.raw_items(),
+        "ephemeral inheritance marker"
+    ));
+    assert!(
+        parent.rollout_path().is_none(),
+        "ephemeral parent must stay unpersisted"
+    );
+}
+
 /// New children inherit omitted plugin choices independently of copied history;
 /// explicit choices, including an empty list, override the parent's selection.
